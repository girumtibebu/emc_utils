 "print_format_type": "Jinja",
 "raw_printing": 0,
 "html": "<!DOCTYPE html>\r\n\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n\r\n  <style>\r\n\r\n    @page {\r\n      size: A4;\r\n      margin: 0;\r\n    }\r\n\r\n    * {\r\n      box-sizing: border-box;\r\n      font-family: Arial, sans-serif;\r\n    }\r\n\r\n    html,\r\n    body {\r\n      width: 100%;\r\n      min-height: 100%;\r\n      margin: 0;\r\n      padding: 0;\r\n      background: #fff;\r\n    }\r\n\r\n    /* =========================\r\n       A4 PAGE\r\n       ========================= */\r\n\r\n    .page-container {\r\n      position: relative;\r\n      width: 100%;\r\n      min-height: 297mm;\r\n      background: #fff;\r\n    }\r\n\r\n    /* Reserve space for footer */\r\n    .content-area {\r\n      padding: 10px 20px 140px 20px;\r\n    }\r\n\r\n    .purple-text {\r\n      color: #6b2d5c;\r\n    }\r\n\r\n    .bold {\r\n      font-weight: bold;\r\n    }\r\n\r\n    .header-table,\r\n    .info-table,\r\n    .items-table {\r\n      width: 100%;\r\n      border-collapse: collapse;\r\n      margin-bottom: 20px;\r\n    }\r\n\r\n    /* =========================\r\n       HEADER\r\n       ========================= */\r\n\r\n    .header-left {\r\n      width: 40%;\r\n      vertical-align: top;\r\n      text-align: left;\r\n      padding: 0;\r\n    }\r\n\r\n    .header-right {\r\n      width: 60%;\r\n      vertical-align: bottom;\r\n      text-align: right;\r\n    }\r\n\r\n    .header-left img {\r\n      max-height: 120px;\r\n      width: auto;\r\n      object-fit: contain;\r\n      display: block;\r\n      margin: 0;\r\n      padding-right: 150px;\r\n    }\r\n\r\n    .doc-title {\r\n      font-size: 32px;\r\n      font-weight: bold;\r\n      color: #6b2d5c;\r\n      text-align: center;\r\n      margin-bottom: 25px;\r\n    }\r\n\r\n    .info-title {\r\n      font-size: 16px;\r\n      font-weight: bold;\r\n      color: #6b2d5c;\r\n      margin-bottom: 8px;\r\n    }\r\n\r\n    /* =========================\r\n       ITEMS TABLE\r\n       ========================= */\r\n\r\n    .items-table {\r\n      width: 100%;\r\n      border: 1.5px solid #000;\r\n      margin-top: 10px;\r\n      margin-bottom: 0;\r\n      table-layout: fixed;\r\n    }\r\n\r\n    .items-table th,\r\n    .items-table td {\r\n      border: 1px solid #000;\r\n      padding: 6px 8px;\r\n      font-size: 12px;\r\n      word-wrap: break-word;\r\n      overflow-wrap: break-word;\r\n    }\r\n\r\n    .items-table th {\r\n      background-color: #fff;\r\n      color: #000;\r\n      font-weight: bold;\r\n      text-align: left;\r\n    }\r\n\r\n    /* =========================\r\n       TOTALS\r\n       ========================= */\r\n\r\n    .totals-table {\r\n      width: 35%;\r\n      margin-left: auto;\r\n      border-collapse: collapse;\r\n      margin-top: 8px;\r\n      margin-bottom: 20px;\r\n    }\r\n\r\n    .totals-table td {\r\n      border: none;\r\n      padding: 4px 8px;\r\n      font-weight: bold;\r\n      font-size: 12px;\r\n    }\r\n\r\n    /* =========================\r\n       STAMP\r\n       ========================= */\r\n\r\n    .stamp-image {\r\n      display: block;\r\n      width: 220px;\r\n      height: auto;\r\n      margin: 8px 0 10px 0;\r\n      object-fit: contain;\r\n    }\r\n\r\n    /* =========================\r\n       PAYMENT TERMS\r\n       ========================= */\r\n\r\n    .payment-terms {\r\n      margin-top: 15px;\r\n      margin-bottom: 0;\r\n      page-break-inside: avoid;\r\n    }\r\n\r\n    .payment-terms ul {\r\n      list-style-type: disc;\r\n      padding-left: 20px;\r\n      margin-top: 8px;\r\n      margin-bottom: 0;\r\n      color: #6b2d5c;\r\n      font-weight: bold;\r\n      font-size: 14px;\r\n    }\r\n\r\n    .payment-terms li {\r\n      margin-bottom: 6px;\r\n    }\r\n\r\n    /* =========================\r\n       FOOTER\r\n       ========================= */\r\n\r\n    .company-footer-banner {\r\n      position: fixed;\r\n      bottom: 0;\r\n      left: 0;\r\n      width: 100%;\r\n      height: 117px;\r\n      background-color: #b28fb8;\r\n      color: #ffffff;\r\n      text-align: center;\r\n      padding: 24px 20px 20px 20px;\r\n      border-top-left-radius: 16px;\r\n      border-top-right-radius: 16px;\r\n      font-size: 14px;\r\n      font-weight: normal;\r\n      line-height: 1.5;\r\n      z-index: 9999;\r\n      display: block;\r\n    }\r\n\r\n    /* =========================\r\n       PRINT FIX\r\n       ========================= */\r\n\r\n    @media print {\r\n\r\n      html,\r\n      body {\r\n        width: 100%;\r\n        min-height: 100%;\r\n        margin: 0;\r\n        padding: 0;\r\n        background: #fff !important;\r\n      }\r\n\r\n      .page-container {\r\n        width: 100%;\r\n        min-height: 297mm;\r\n        background: #fff !important;\r\n      }\r\n\r\n      .content-area {\r\n        padding: 10px 20px 140px 20px;\r\n      }\r\n\r\n      .items-table {\r\n        width: 100%;\r\n        table-layout: fixed;\r\n      }\r\n\r\n      .payment-terms {\r\n        page-break-inside: avoid;\r\n      }\r\n\r\n      .company-footer-banner {\r\n        position: fixed;\r\n        bottom: 0;\r\n        left: 0;\r\n        width: 100%;\r\n        height: 117px;\r\n        background-color: #b28fb8 !important;\r\n      }\r\n\r\n    }\r\n\r\n  </style>\r\n\r\n</head>\r\n\r\n<body>\r\n\r\n<div class=\"page-container\">\r\n\r\n  <div class=\"content-area\">\r\n\r\n\r\n<!-- =========================\r\n     TOP HEADER\r\n     ========================= -->\r\n\r\n<table class=\"header-table\">\r\n  <tr>\r\n\r\n    <td class=\"header-left\">\r\n\r\n      <img\r\n        src=\"/files/Alter .png\"\r\n        alt=\"Alter Space Logo\"\r\n      >\r\n\r\n    </td>\r\n\r\n    <td class=\"header-right\">\r\n\r\n      <div>\r\n        <span class=\"purple-text bold\">\r\n          Ref.No:\r\n        </span>\r\n\r\n        <u>\r\n          {{ doc.name }}\r\n        </u>\r\n      </div>\r\n\r\n      <div>\r\n        <span class=\"purple-text bold\">\r\n          Date:\r\n        </span>\r\n\r\n        <u>\r\n          {{ doc.get_formatted(\"transaction_date\") }}\r\n        </u>\r\n      </div>\r\n\r\n      <div>\r\n        <span class=\"purple-text bold\">\r\n          Valid Till:\r\n        </span>\r\n\r\n        <u>\r\n          {{ doc.get_formatted(\"valid_till\") or '' }}\r\n        </u>\r\n      </div>\r\n\r\n    </td>\r\n\r\n  </tr>\r\n</table>\r\n\r\n\r\n<!-- =========================\r\n     QUOTATION TITLE\r\n     ========================= -->\r\n\r\n<div class=\"doc-title\">\r\n  Quotation\r\n</div>\r\n\r\n\r\n<!-- =========================\r\n     CLIENT & EVENT DETAILS\r\n     ========================= -->\r\n\r\n<table class=\"info-table\">\r\n\r\n  <tr>\r\n\r\n    <!-- CLIENT INFORMATION -->\r\n\r\n    <td\r\n      style=\"\r\n        width: 55%;\r\n        vertical-align: top;\r\n      \"\r\n    >\r\n\r\n      <div class=\"info-title\">\r\n        Client Information\r\n      </div>\r\n\r\n      <div>\r\n\r\n        <span class=\"purple-text bold\">\r\n          Company Name:\r\n        </span>\r\n\r\n        <u>\r\n          {{ doc.customer_name or '' }}\r\n        </u>\r\n\r\n      </div>\r\n\r\n      <div>\r\n\r\n        <span class=\"purple-text bold\">\r\n          Contact Person:\r\n        </span>\r\n\r\n        <u>\r\n          {{ doc.contact_name or '' }}\r\n        </u>\r\n\r\n      </div>\r\n\r\n      <div>\r\n\r\n        <span class=\"purple-text bold\">\r\n          Phone Number:\r\n        </span>\r\n\r\n        <u>\r\n          {{ doc.phone or '' }}\r\n        </u>\r\n\r\n      </div>\r\n\r\n    </td>\r\n\r\n\r\n    <!-- EVENT DETAILS -->\r\n\r\n    <td\r\n      style=\"\r\n        width: 45%;\r\n        vertical-align: top;\r\n        text-align: right;\r\n      \"\r\n    >\r\n\r\n      <div class=\"info-title\">\r\n        Event Details\r\n      </div>\r\n\r\n      <div>\r\n\r\n        <span class=\"purple-text bold\">\r\n          Event Name:\r\n        </span>\r\n\r\n        <u>\r\n          {{ doc.title or '' }}\r\n        </u>\r\n\r\n      </div>\r\n\r\n      <div>\r\n\r\n        <span class=\"purple-text bold\">\r\n          Event Date:\r\n        </span>\r\n\r\n        <u>\r\n          {{ doc.get_formatted(\"event_date\") or '' }}\r\n        </u>\r\n\r\n      </div>\r\n\r\n      <div>\r\n\r\n        <span class=\"purple-text bold\">\r\n          Location:\r\n        </span>\r\n\r\n        <u>\r\n          {{ doc.event_location or '' }}\r\n        </u>\r\n\r\n      </div>\r\n\r\n      <div>\r\n\r\n        <span class=\"purple-text bold\">\r\n          Setup Date:\r\n        </span>\r\n\r\n        <u>\r\n          {{ doc.get_formatted(\"setup_date\") or '' }}\r\n        </u>\r\n\r\n      </div>\r\n\r\n    </td>\r\n\r\n  </tr>\r\n\r\n</table>\r\n\r\n\r\n<!-- =========================\r\n     ITEMS TABLE\r\n     ========================= -->\r\n\r\n<table class=\"items-table\">\r\n\r\n  <thead>\r\n\r\n    <tr>\r\n\r\n      <th\r\n        style=\"\r\n          width: 5%;\r\n          text-align: center;\r\n        \"\r\n      >\r\n        No\r\n      </th>\r\n\r\n      <th style=\"width: 20%;\">\r\n        Item Name\r\n      </th>\r\n\r\n      <th style=\"width: 25%;\">\r\n        Description\r\n      </th>\r\n\r\n      <th style=\"width: 12%;\">\r\n        UOM\r\n      </th>\r\n\r\n      <th\r\n        style=\"\r\n          width: 8%;\r\n          text-align: center;\r\n        \"\r\n      >\r\n        Days\r\n      </th>\r\n\r\n      <th\r\n        style=\"\r\n          width: 8%;\r\n          text-align: center;\r\n        \"\r\n      >\r\n        Qty\r\n      </th>\r\n\r\n      <th\r\n        style=\"\r\n          width: 11%;\r\n          text-align: right;\r\n        \"\r\n      >\r\n        Unit Price\r\n      </th>\r\n\r\n      <th\r\n        style=\"\r\n          width: 11%;\r\n          text-align: right;\r\n        \"\r\n      >\r\n        Total Price\r\n      </th>\r\n\r\n    </tr>\r\n\r\n  </thead>\r\n\r\n\r\n  <tbody>\r\n\r\n    {% for row in doc.items %}\r\n\r\n    <tr>\r\n\r\n      <td style=\"text-align: center;\">\r\n        {{ loop.index }}\r\n      </td>\r\n\r\n      <td>\r\n        {{ row.item_name }}\r\n      </td>\r\n\r\n      <td>\r\n        {{ row.description or '' }}\r\n      </td>\r\n\r\n      <td>\r\n        {{ row.uom or '' }}\r\n      </td>\r\n\r\n      <td style=\"text-align: center;\">\r\n        {{ row.custom_number_of_days or row.no_of_days or 1 }}\r\n      </td>\r\n\r\n      <td style=\"text-align: center;\">\r\n        {{ row.qty }}\r\n      </td>\r\n\r\n      <td style=\"text-align: right;\">\r\n        {{ row.get_formatted(\"rate\", doc) }}\r\n      </td>\r\n\r\n      <td style=\"text-align: right;\">\r\n        {{ row.get_formatted(\"amount\", doc) }}\r\n      </td>\r\n\r\n    </tr>\r\n\r\n    {% endfor %}\r\n\r\n  </tbody>\r\n\r\n</table>\r\n\r\n\r\n<!-- =========================\r\n     STAMP + TOTALS\r\n     ========================= -->\r\n\r\n{% set vat_amount = (doc.net_total or 0) * 0.15 %}\r\n{% set calculated_grand_total = (doc.net_total or 0) + vat_amount %}\r\n\r\n<table\r\n  style=\"\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-top: 8px;\r\n    margin-bottom: 20px;\r\n  \"\r\n>\r\n\r\n  <tr>\r\n\r\n    <!-- LEFT SIDE: HELINA STAMP -->\r\n\r\n    <td\r\n      style=\"\r\n        width: 65%;\r\n        vertical-align: top;\r\n        text-align: left;\r\n      \"\r\n    >\r\n\r\n      <img\r\n        class=\"stamp-image\"\r\n        src=\"/files/Helina.png\"\r\n        alt=\"Company Stamp\"\r\n      >\r\n\r\n    </td>\r\n\r\n\r\n    <!-- RIGHT SIDE: TOTALS -->\r\n\r\n    <td\r\n      style=\"\r\n        width: 35%;\r\n        vertical-align: top;\r\n      \"\r\n    >\r\n\r\n      <table\r\n        class=\"totals-table\"\r\n        style=\"\r\n          width: 100%;\r\n          margin: 0;\r\n        \"\r\n      >\r\n\r\n        <tr>\r\n\r\n          <td style=\"text-align: left;\">\r\n            Sub Total\r\n          </td>\r\n\r\n          <td style=\"text-align: right;\">\r\n            {{ doc.get_formatted(\"net_total\") }}\r\n          </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n          <td style=\"text-align: left;\">\r\n            Vat 15%\r\n          </td>\r\n\r\n          <td style=\"text-align: right;\">\r\n            {{ frappe.utils.fmt_money(\r\n              vat_amount,\r\n              currency=doc.currency\r\n            ) }}\r\n          </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n          <td style=\"text-align: left;\">\r\n            Grand Total\r\n          </td>\r\n\r\n          <td style=\"text-align: right;\">\r\n            {{ frappe.utils.fmt_money(\r\n              calculated_grand_total,\r\n              currency=doc.currency\r\n            ) }}\r\n          </td>\r\n\r\n        </tr>\r\n\r\n      </table>\r\n\r\n    </td>\r\n\r\n  </tr>\r\n\r\n</table>\r\n\r\n\r\n<!-- =========================\r\n     PAYMENT TERMS\r\n     ALWAYS SHOW ALL 4\r\n     ========================= -->\r\n\r\n<div class=\"payment-terms\">\r\n\r\n  <div class=\"info-title\">\r\n    Payment Terms\r\n  </div>\r\n\r\n  <ul>\r\n\r\n    <li>\r\n      30% Booking confirmation\r\n    </li>\r\n\r\n    <li>\r\n      50% Before Installation\r\n    </li>\r\n\r\n    <li>\r\n      20% After Collection\r\n    </li>\r\n\r\n    <li>\r\n      Security deposit if applicable\r\n    </li>\r\n\r\n  </ul>\r\n\r\n</div>\r\n\r\n\r\n  </div>\r\n\r\n  <!-- =========================\r\n       FOOTER\r\n       ========================= -->\r\n\r\n  <div class=\"company-footer-banner\">\r\n<p style=\"font-size: 20px; font-weight: bold;\">\r\n  Thank you for your business.<br></p>\r\n\r\nWello Sefer Garad Mall 2nd floor, Addis Ababa, Ethiopia<br>\r\n\r\nPhone: +251923060628, Email: helinamulatu@alter-decor.com\r\n\r\n\r\n  </div>\r\n\r\n</div>\r\n\r\n</body>\r\n</html>",
