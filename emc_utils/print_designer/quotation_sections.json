    {
      "label": "",
      "columns": [
        {
          "label": "",
          "fields": [
            {
              "label": "Section Enhancer",
              "fieldname": "custom_html_enhancer",
              "fieldtype": "HTML",
              "html": "<script>\n(function() {\n    function enhanceSections() {\n        var headers = document.querySelectorAll('.emc-print-section-header, [data-is-section=\"1\"]');\n        headers.forEach(function(h) {\n            var row = h.closest('tr');\n            if (row && !row.classList.contains('emc-print-section-row')) {\n                row.classList.add('emc-print-section-row');\n                var cells = row.querySelectorAll('td.column-value');\n                var itemCell = row.querySelector('td.column-value[data-fieldname=\"item_name\"]');\n                if (itemCell && cells.length > 2) {\n                    itemCell.colSpan = cells.length - 1;\n                }\n                cells.forEach(function(cell) {\n                    var fn = cell.getAttribute('data-fieldname');\n                    if (fn !== 'item_name' && fn !== 'idx' && fn !== 'section_title') {\n                        cell.style.display = 'none';\n                    }\n                });\n            }\n        });\n    }\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', enhanceSections);\n    } else {\n        enhanceSections();\n    }\n    setTimeout(enhanceSections, 100);\n    setTimeout(enhanceSections, 500);\n})();\n</script>",
              "custom": 1
            }
          ]
        }
      ]
    },
